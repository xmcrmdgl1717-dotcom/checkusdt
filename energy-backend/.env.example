# 服务端口
PORT=3000

# TronGrid API Key（https://www.trongrid.io/ 免费申请）
TRONGRID_API_KEY=你的key

# 资源池地址（已质押 TRX、有权 delegateResource 的地址）
RESOURCE_POOL_ADDRESS=T你的资源池地址

# 资源池地址私钥 —— 只放在服务器环境变量，绝不提交到代码仓库
RESOURCE_POOL_PRIVATE_KEY=你的私钥

# 收款地址（展示给用户转账的地址，只需要“收 TRX”，不需要质押）
RENTAL_RECEIVE_ADDRESS=T你的收款地址

# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=chageu
DB_PASSWORD=你的数据库密码
DB_NAME=chageu_energy

# 监听轮询间隔（毫秒）
POLL_INTERVAL_MS=5000

# 1 小时 = 1200 个区块（每块 3 秒）
LOCK_PERIOD_BLOCKS=1200
